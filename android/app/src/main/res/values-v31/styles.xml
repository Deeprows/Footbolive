<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style
        name="AppTheme"
        parent="Theme.SplashScreen">

        <!-- Android system splash background -->
        <item name="windowSplashScreenBackground">
            #07090D
        </item>

        <!-- Small system splash icon only -->
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/ic_deeprows
        </item>

        <item name="windowSplashScreenIconBackgroundColor">
            #07090D
        </item>

        <!-- Switch to the normal application theme -->
        <item name="postSplashScreenTheme">
            @style/AppThemeMain
        </item>

    </style>

</resources>
