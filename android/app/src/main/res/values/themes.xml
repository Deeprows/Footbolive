<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Main application theme -->
    <style
        name="Theme.Deeprowss"
        parent="android:style/Theme.Material.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <item name="android:windowNoTitle">true</item>

        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowBackground">#07090D</item>

        <!-- Status bar is hidden by MainActivity -->
        <item name="android:statusBarColor">#07090D</item>

        <!-- Navigation bar remains visible -->
        <item name="android:navigationBarColor">#07090D</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:colorAccent">#00C853</item>

    </style>


    <!-- Splash screen theme -->
    <style
        name="Theme.Deeprowss.Splash"
        parent="android:style/Theme.Material.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <item name="android:windowNoTitle">true</item>

        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowBackground">#07090D</item>

        <!-- Status bar hidden by SplashActivity -->
        <item name="android:statusBarColor">#07090D</item>

        <!-- Navigation bar remains visible -->
        <item name="android:navigationBarColor">#07090D</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:colorAccent">#00C853</item>

    </style>

</resources>
